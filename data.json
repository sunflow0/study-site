    "grammar": {
      "IELTS": [
        {
          "t": "Second Conditional",
          "f": "If + Past Simple, would + V1",
          "ex": [
            "If I won the lottery, I would travel."
          ],
          "mis": "✗ If I would win → ✓ If I won"
        },
        {
          "t": "Relative Clause",
          "f": "noun + who/which/that + clause",
          "ex": [
            "The book that I read was great."
          ],
          "mis": "✗ The man who he lives → ✓ The man who lives"
        },
        {
          "t": "Passive Voice",
          "f": "be + V3",
          "ex": [
            "The report was written by Tom."
          ],
          "mis": "ใช้เมื่อสนใจสิ่งที่ถูกกระทำมากกว่าคนทำ"
        }
      ],
      "TOEIC": [
        {
          "t": "Subject-Verb Agreement",
          "f": "singular subject + V-s / plural subject + V",
          "ex": [
            "The manager approves the plan.",
            "The managers approve the plan."
          ],
          "mis": "✗ The list of items are → ✓ The list of items is"
        },
        {
          "t": "Part of Speech",
          "f": "adj. + noun / adv. + verb",
          "ex": [
            "a successful project",
            "carefully review"
          ],
          "mis": "✗ a success project → ✓ a successful project"
        }
      ]
    }
